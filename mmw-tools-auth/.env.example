# Feishu self-built web app
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_TENANT_KEY=xxxxxxxxxxxxxxxx

# Minimum identity scope required by the user_info endpoint. Leave empty if
# the app needs no additional scope; fill it if Feishu rejects user_info.
FEISHU_USER_SCOPES=

# Who becomes the first admin. You can leave this empty and use
# MMW_BOOTSTRAP_TOKEN instead (recommended when you do not know your open_id).
MMW_ADMIN_OPEN_ID=

# One-time bootstrap token. Generate with:
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
# Open /auth/feishu/start?bootstrap=<token> once, then remove this variable.
MMW_BOOTSTRAP_TOKEN=

# Public origin; must match the Feishu callback URL.
MMW_ORIGIN=https://mmw-tools.mmw-team.icu
MMW_PORT=4326
MMW_DATA_DIR=./data

# Path to the shared contracts directory. In the repo this is ../contracts;
# in a standalone deployment copy contracts/ next to this service and point
# this variable at it.
MMW_CONTRACTS_DIR=../contracts

MMW_PLUGIN_TOKEN_TTL_SECONDS=604800
