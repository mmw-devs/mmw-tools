[Unit]
Description=Probe the mmw-tools auth core and restart it after sustained failure
Documentation=file:///opt/mmw-tools-auth/deploy/README.md
After=mmw-tools-auth.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mmw-auth-healthcheck --restart
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run
