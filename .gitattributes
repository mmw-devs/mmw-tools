# Deployment artifacts are copied from a Windows checkout to Linux. Without
# this, core.autocrlf=true can put CRLF in a shebang or a systemd unit.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
