{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mmw-team.icu/contracts/tools.schema.json",
  "title": "mmw-tools tool catalog",
  "description": "工具是授权单位；每个工具声明自己需要的技术权限、可消费它的角色，以及内部 operation。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "tools"],
  "properties": {
    "contractVersion": {
      "const": 2,
      "description": "契约版本；当前为 2（tool-centric）。"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "description": "工具列表；角色只决定能否消费工具，不直接映射到权限。",
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "toolId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "工具 ID，例如 race-ops；mcp__mmw-tools__* 的父工具。"
    },
    "roleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "成员角色 ID；必须在 roles.json 中声明。"
    },
    "permissionId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+:[a-z0-9_:-]+$",
      "description": "工具需要的技术权限，例如 github:contents:write；不是发给用户的授权。"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "工具内部 operation ID，例如 repo_read / pr_merge。"
    },
    "publicName": {
      "type": "string",
      "pattern": "^(?:mcp__[a-z0-9-]+__(?:[a-z0-9_]+__)?[A-Za-z0-9_-]+|[A-Za-z0-9_]+)$",
      "description": "agent 看到的工具名；MCP 工具为 mcp__...，原生工具为 mmw_tools_*。"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "publicName", "description", "risk"],
      "properties": {
        "id": {
          "$ref": "#/$defs/operationId"
        },
        "publicName": {
          "$ref": "#/$defs/publicName"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "给 agent 的 operation 说明；不要写敏感信息。"
        },
        "risk": {
          "enum": ["read", "write"],
          "description": "read 可在授权表过期时走 grace；write 在授权表不新鲜时 fail closed。"
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "description": "可选；未来 operation-level 角色覆盖。未设置时继承 tool.roles。",
          "items": {
            "$ref": "#/$defs/roleId"
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "roles", "requiredPermissions", "operations"],
      "properties": {
        "id": {
          "$ref": "#/$defs/toolId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "工具显示名。"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "工具说明，面向用户/管理员。"
        },
        "always": {
          "type": "boolean",
          "description": "true 表示所有成员都可消费；用于状态/诊断工具。"
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "description": "可以消费该工具的角色；always=true 时可以为空。",
          "items": {
            "$ref": "#/$defs/roleId"
          }
        },
        "requiredPermissions": {
          "type": "array",
          "uniqueItems": true,
          "description": "工具自身需要的能力/凭据；不是用户授权。",
          "items": {
            "$ref": "#/$defs/permissionId"
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "description": "工具内部的 operation；授权单位仍是 tool。",
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    }
  }
}
