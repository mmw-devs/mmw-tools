{
  "contractVersion": 2,
  "tools": [
    {
      "id": "race-ops",
      "title": "FFXIV Race Ops 运营",
      "description": "在绑定的 race-ops 仓库上执行读取、编辑、开 PR 与合并的完整运营流程。",
      "roles": [
        "operator",
        "admin"
      ],
      "requiredPermissions": [
        "github:contents:write",
        "github:pull_requests:write"
      ],
      "operations": [
        {
          "id": "select_repo",
          "publicName": "mcp__mmw-tools__select_repo",
          "description": "选择本会话要操作的仓库（owner/name）。选定后本会话的业务工具都作用于该仓库，同一会话不能改选另一个仓库。",
          "risk": "read",
          "roles": [
            "viewer",
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "repo_status",
          "publicName": "mcp__mmw-tools__repo_status",
          "description": "查看工作副本的分支、脏状态、HEAD 和未提交文件。",
          "risk": "read",
          "roles": [
            "viewer",
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "repo_clone",
          "publicName": "mcp__mmw-tools__repo_clone",
          "description": "把绑定的仓库克隆到 working_dir（浅克隆 base branch）。",
          "risk": "read",
          "roles": [
            "viewer",
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "repo_pull",
          "publicName": "mcp__mmw-tools__repo_pull",
          "description": "在指定分支上从 origin 拉取最新变更（--rebase）。",
          "risk": "read",
          "roles": [
            "viewer",
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "repo_read",
          "publicName": "mcp__mmw-tools__repo_read",
          "description": "读取工作副本中的单个文件（默认 100 KiB，硬上限 500 KiB）。",
          "risk": "read",
          "roles": [
            "viewer",
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "repo_search",
          "publicName": "mcp__mmw-tools__repo_search",
          "description": "在工作副本里用 git grep 搜索。",
          "risk": "read",
          "roles": [
            "viewer",
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "repo_edit",
          "publicName": "mcp__mmw-tools__repo_edit",
          "description": "在 content/* 分支上批量编辑、跑 preflight、本地 commit（不 push）。",
          "risk": "write",
          "roles": [
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "pr_create",
          "publicName": "mcp__mmw-tools__pr_create",
          "description": "推送 content/* 分支并创建一个 PR。",
          "risk": "write",
          "roles": [
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "pr_close",
          "publicName": "mcp__mmw-tools__pr_close",
          "description": "关闭一个 content/* 分支的 PR（不合并）；宿主会在执行前确认。",
          "risk": "write",
          "roles": [
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "pr_list",
          "publicName": "mcp__mmw-tools__pr_list",
          "description": "列出仓库里现有的 PR。",
          "risk": "read",
          "roles": [
            "viewer",
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "pr_preview",
          "publicName": "mcp__mmw-tools__pr_preview",
          "description": "读取 PR 的预览地址和检查状态，只读。",
          "risk": "read",
          "roles": [
            "viewer",
            "editor",
            "operator",
            "admin"
          ]
        },
        {
          "id": "pr_merge",
          "publicName": "mcp__mmw-tools__pr_merge",
          "description": "合并 PR；必须由用户明确要求，宿主会在执行前确认。若 PR 声明的 command 在契约中属于 agentMerge=false 的级别（如 L3），拒绝合并。",
          "risk": "write",
          "roles": [
            "operator",
            "admin"
          ]
        },
        {
          "id": "mmw_tools_run",
          "publicName": "mmw_tools_run",
          "description": "为 agent 准备仓库上下文和 AGENTS.md 约束。",
          "risk": "read",
          "roles": [
            "operator",
            "admin"
          ]
        }
      ]
    },
    {
      "id": "mmw-tools-status",
      "title": "MMW Tools 状态",
      "description": "查看插件状态、授权表和仓库绑定；始终可用。",
      "always": true,
      "roles": [],
      "requiredPermissions": [],
      "operations": [
        {
          "id": "status",
          "publicName": "mmw_tools_status",
          "description": "查看插件状态、授权表和仓库绑定。",
          "risk": "read"
        }
      ]
    }
  ]
}
