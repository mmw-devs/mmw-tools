# Explicit ignore rules for the npm tarball.
#
# This file exists because npm falls back to .gitignore when no
# .npmignore is present, and .gitignore excludes `lib/` — which is
# exactly what the published package must contain. With this file the
# `files` allowlist in package.json plus these rules decide the
# tarball, and the two together are correct.

# Sources and tests are not shipped; `lib/` and `mcp-server/dist/` are.
src/
tests/
client-build/
mcp-server/src/
mcp-server/tests/

# Deps and build caches
node_modules/
*.tsbuildinfo
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store

# Local credentials and keys — never ship these
.env
.env.local
*.pem
.dsh-github-engineer.json
.dsh-github-engineer-audit.jsonl

# pnpm workspace metadata
pnpm-lock.yaml
.npmrc
