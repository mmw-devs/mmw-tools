{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "client-build",
    "rootDir": "src",
    "types": []
  },
  "include": ["src/client/api.ts", "src/shared/api-paths.ts"],
  "exclude": [
    "node_modules",
    "lib",
    "client-build",
    "mcp-server",
    "tests",
    "src/index.ts",
    "src/auth/**",
    "src/routes.ts",
    "src/agents-md-check.ts",
    "src/const.ts",
    "src/client/index.js"
  ]
}